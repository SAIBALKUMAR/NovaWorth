# =====================================================
# NovaWorth — Environment Configuration
# Copy to .env and fill in real values
# NEVER commit .env to git
# =====================================================

# ----- Database -----
DATABASE_URL=postgresql://app:dev_password@localhost:5432/novaworth

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Service Ports -----
UI_PORT=3000
API_PORT=4000
GENAI_PORT=5000

# ----- API Internal URL (UI calls this) -----
INTERNAL_API_URL=http://localhost:4000
INTERNAL_GENAI_URL=http://localhost:5000

# ----- Auth Secrets -----
SESSION_SECRET=change_me_to_at_least_64_random_bytes_in_production_please

# ----- OAuth: GitHub -----
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:4000/auth/github/callback

# ----- OAuth: Google -----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:4000/auth/google/callback

# ----- AI -----
OPENAI_API_KEY=sk-...
OPENAI_MONTHLY_BUDGET_USD=20

# ----- Email (Resend) -----
RESEND_API_KEY=re_...
EMAIL_FROM=NovaWorth <no-reply@novaworth.ai>

# ----- Storage (Cloudflare R2) -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=novaworth-assets
R2_PUBLIC_URL=https://assets.novaworth.ai

# ----- App -----
APP_ENV=development
APP_URL=http://localhost:3000

# ----- Leptos -----
LEPTOS_OUTPUT_NAME=novaworth
LEPTOS_SITE_ROOT=site
LEPTOS_SITE_PKG_DIR=pkg
LEPTOS_SITE_ADDR=0.0.0.0:3000
LEPTOS_ENV=DEV
